# Optional integration fixtures are built separately; see tests/fixtures/README.md.
if(INNOEXTRACT_TEST_FIXTURES_DIR)
	if(NOT EXISTS "${INNOEXTRACT_TEST_FIXTURES_DIR}/manifest.json")
		message(FATAL_ERROR "INNOEXTRACT_TEST_FIXTURES_DIR must contain manifest.json")
	endif()
	if(CMAKE_VERSION VERSION_LESS 3.12)
		find_package(PythonInterp 3.8 REQUIRED)
		set(fixture_python "${PYTHON_EXECUTABLE}")
	else()
		find_package(Python3 3.8 REQUIRED COMPONENTS Interpreter)
		set(fixture_python "${Python3_EXECUTABLE}")
	endif()
	if(CMAKE_VERSION VERSION_LESS 3.0)
		get_property(fixture_extractor TARGET innoextract PROPERTY LOCATION)
	else()
		set(fixture_extractor "$<TARGET_FILE:innoextract>")
	endif()
	set(fixture_wrapper)
	foreach(argument ${RUN_TARGET})
		list(APPEND fixture_wrapper "--wrapper=${argument}")
	endforeach()
	set(fixture_command "${fixture_python}" "${PROJECT_SOURCE_DIR}/tests/check-fixtures.py"
		--extractor "${fixture_extractor}" --fixtures "${INNOEXTRACT_TEST_FIXTURES_DIR}"
		--output "${PROJECT_BINARY_DIR}/format-results" ${fixture_wrapper})
	file(STRINGS "${PROJECT_SOURCE_DIR}/tests/fixtures/cases.txt" fixture_cases)
	foreach(fixture_case ${fixture_cases})
		add_test(NAME "format-${fixture_case}" COMMAND ${fixture_command} --case "${fixture_case}")
		set_tests_properties("format-${fixture_case}" PROPERTIES TIMEOUT 180 LABELS "format")
	endforeach()
	add_test(NAME format-invalid-inputs COMMAND ${fixture_command} --negative)
	set_tests_properties(format-invalid-inputs PROPERTIES TIMEOUT 540 LABELS "format")
endif()
